# Mercado Livre (mantenha os valores reais somente no arquivo .env)
ML_CLIENT_ID=COLE_AQUI
ML_CLIENT_SECRET=COLE_AQUI
ML_REDIRECT_URI=https://SEU-TUNEL/callback

# Supabase (use a chave secreta somente no servidor, nunca no navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=COLE_AQUI_A_CHAVE_SECRETA

# Login do painel (use o mesmo e-mail criado em Authentication > Users)
ADMIN_EMAIL=nycolasrsilva1@gmail.com

# URL pública definitiva, usada nas prévias de WhatsApp, Google, Facebook e Discord.
# Em testes locais, deixe em branco. Ao publicar, use por exemplo: https://economizai.com.br
SITE_URL=

# E-mail de alertas (configure quando criar uma chave gratuita no Resend)
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=Economizaí <onboarding@resend.dev>
