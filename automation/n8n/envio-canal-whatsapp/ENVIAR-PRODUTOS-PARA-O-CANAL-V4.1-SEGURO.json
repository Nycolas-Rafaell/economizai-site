    {
      "parameters": {
        "jsCode": "const dados = $('DADOS DO PRODUTO').first().json;\nconst nome = String(dados.nomeProduto || 'Produto em oferta').trim();\nconst preco = String(dados.preco || '').trim();\nconst link = String(dados.linkProduto || '').trim();\nconst extra = String(dados.mensagemAdicional || '').trim();\n\nconst linhasPreco = preco.split(/\\\\n|\\n/).map(v => v.trim()).filter(Boolean);\nconst precoAntigo = linhasPreco[0] || '';\nconst precoAtual = linhasPreco[1] || precoAntigo;\nconst desconto = linhasPreco[2] || '';\n\nconst legenda = [\n  '🔥 *OFERTA DO DIA* 🔥',\n  `🛍️ *${nome}*`,\n  precoAntigo && precoAtual !== precoAntigo ? `De: ~R$ ${precoAntigo.replace(/^R\\$\\s*/, '')}~` : '',\n  precoAtual ? `💰 *Por apenas: R$ ${precoAtual.replace(/^R\\$\\s*/, '')}*` : '',\n  desconto ? `📉 *${desconto}*` : '',\n  '🛒 *CLIQUE E APROVEITE:*',\n  link,\n  extra,\n  '_⚡ Preço e disponibilidade podem mudar a qualquer momento._',\n].filter(Boolean).join('\\n\\n');\n\nreturn [{ json: { legenda } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
